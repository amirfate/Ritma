{
  "name": "@ritma/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Pino logging setup shared by Ritma services, with secret redaction baked in.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "nestjs-pino": "^4.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@ritma/tooling": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
