{
  "name": "@ritma/config",
  "version": "0.1.0",
  "private": true,
  "description": "Validated runtime environment configuration shared by Ritma services.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ritma/tooling": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
