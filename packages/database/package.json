{
  "name": "@ritma/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and generated client shared by Ritma services.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@ritma/tooling": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.30.0",
    "prisma": "^6.2.0",
    "typescript": "^5.8.0"
  }
}
