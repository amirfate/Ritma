{
  "name": "ritma",
  "version": "0.1.0",
  "private": true,
  "description": "Ritma monorepo — Android app, NestJS backend, and shared workspace packages.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "clean": "turbo run clean",
    "dev:backend": "pnpm --filter @ritma/backend start:dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@ritma/configs": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0"
  }
}
