# Fixture environment for automated test runs (Jest, CI). These are not
# real secrets — they only need to satisfy the env schema's shape so the
# app can boot in a test environment. CI overrides DATABASE_URL/REDIS_URL
# at the job level to point at its own Postgres/Redis services; dotenv
# does not override variables already present in the process environment,
# so those job-level values win over what's below.

NODE_ENV=test
PORT=3000

DATABASE_URL=postgresql://ritma:ritma@localhost:5432/ritma
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ritma
MINIO_SECRET_KEY=ritma-minio
MINIO_BUCKET=ritma-tracks-test
MINIO_USE_SSL=false

JWT_ACCESS_SECRET=test-access-secret-not-for-production-use-000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-use-00000
JWT_REFRESH_TTL=30d

SMS_IR_API_KEY=test-sms-ir-api-key
SMS_IR_TEMPLATE_ID=test-sms-ir-template-id
