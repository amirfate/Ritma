# Ritma API environment. Copy to `.env` for local development:
#   cp apps/api/.env.example apps/api/.env

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the Nest application listens on.
PORT=3000

# Matches the `postgres` / `redis` services in
# infrastructure/docker/docker-compose.yml.
DATABASE_URL=postgresql://ritma:ritma@localhost:5432/ritma
REDIS_URL=redis://localhost:6379

# Matches the `minio` service in infrastructure/docker/docker-compose.yml.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ritma
MINIO_SECRET_KEY=ritma-minio
MINIO_BUCKET=ritma-tracks
MINIO_USE_SSL=false

# Generate real secrets for any non-local environment, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-real-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
JWT_REFRESH_TTL=30d

# sms.ir Verify API credentials — see https://sms.ir for dashboard access.
SMS_IR_API_KEY=replace-with-your-sms-ir-api-key
SMS_IR_TEMPLATE_ID=replace-with-your-sms-ir-otp-template-id
